pipeline {
  agent any
  stages {
    stage('Build') { 
        steps { 
          sh 'docker build -t web-uoc:1.0 .'
        } 
      }
    stage('Cargar imagen en Minikube') {
      steps { 
        sh 'minikube image load web-uoc:1.0'
        } 
      }
    stage('Deploy') {
      steps { 
        sh 'sed "s/BUILD_TAG_PLACEHOLDER/$BUILD_NUMBER/" k8s/deployment.yaml | kubectl apply -f -'
        sh 'kubectl apply -f k8s/service.yaml' 
        sh 'kubectl rollout status deployment/web-uoc --timeout=120s'
        } 
      }
    }
}
